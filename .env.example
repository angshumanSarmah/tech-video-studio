# Copy to .env at the repo root. Loaded by the server and worker processes.

# DeepSeek API key used by the shared LLM client (optional at boot; required to run agents).
# Overrides llm.apiKey in <DATA_DIR>/config.json. Other editable settings (models, prices, TTS,
# render presets) live in that file; it is optional and defaults apply when it is missing.
DEEPSEEK_API_KEY=

# Runtime data directory (SQLite DB, runs/, assets/, exports/). Relative paths resolve from the repo root.
DATA_DIR=./data

# HTTP port for the Hono server. The Vite dev server proxies /api to it.
PORT=8787

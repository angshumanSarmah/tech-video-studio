{
  "name": "@explainer-studio/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#core/*": "./src/core/*",
    "#server/*": "./src/server/*",
    "#worker/*": "./src/worker/*",
    "#web/*": "./src/web/*"
  },
  "scripts": {
    "dev": "pnpm db:migrate && concurrently --kill-others-on-fail --names server,worker,web --prefix-colors blue,magenta,green \"pnpm:dev:server\" \"pnpm:dev:worker\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsup",
    "start": "node dist/node/db/migrate-cli.js && concurrently --names server,worker \"node dist/node/server/index.js\" \"node dist/node/worker/index.js\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/core/db/migrate-cli.ts",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "gen:theme": "tsx scripts/generate-theme-css.ts",
    "bench:render": "tsx scripts/benchmark-render.ts",
    "tts:setup": "bash tts-python/setup.sh",
    "tts:doctor": "tsx scripts/tts-doctor.ts",
    "tts:fixture": "tsx scripts/tts-fixture.ts",
    "research:fixture": "tsx scripts/research-fixture.ts"
  },
  "dependencies": {
    "@explainer-studio/renderer": "workspace:*",
    "@explainer-studio/shared": "workspace:*",
    "@hono/node-server": "catalog:",
    "@mozilla/readability": "catalog:",
    "@remotion/bundler": "catalog:",
    "@remotion/renderer": "catalog:",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:",
    "fast-xml-parser": "catalog:",
    "hono": "catalog:",
    "jsdom": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "unpdf": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "concurrently": "catalog:",
    "drizzle-kit": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}

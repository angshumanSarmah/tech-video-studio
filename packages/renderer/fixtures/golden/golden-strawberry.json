          "primitive": "tag",
          "props": { "text": "straw", "semantic": "concept" },
          "zone": "stage"
        },
        {
          "id": "tok-2",
          "primitive": "tag",
          "props": { "text": "berry", "semantic": "concept" },
          "zone": "stage"
        },
        {

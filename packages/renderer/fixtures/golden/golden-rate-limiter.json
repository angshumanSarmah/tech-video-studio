{
  "schemaVersion": 1,
  "meta": {
    "id": "golden-rate-limiter",
    "series": "system-design",
    "title": "How a rate limiter works",
    "topicClass": "concept",
    "targetLengthSec": 80
  },
  "story": {
    "devices": ["question_chapters", "failure_before_fix", "planted_question"],
    "heroMetric": { "label": "Limit", "value": "100 req/min" },
    "chapters": [
      { "id": "why", "title": "The flood", "question": "Why limit at all?" },
      { "id": "count", "title": "Counting", "question": "Why not log every request?" },
      { "id": "bucket", "title": "Token bucket", "question": "How does a bucket refill?" },
      { "id": "store", "title": "Shared counter", "question": "Where does the count live?" },
      { "id": "fleet", "title": "Many servers", "question": "What about many servers?" },
      { "id": "payoff", "title": "Why it holds", "question": "So why did the API fall over?" }
    ],
    "beats": [
      {
        "id": "hook",
        "chapterId": "why",
        "intent": "One buggy script floods the API and every user gets errors",
        "device": "failure_before_fix",
        "targetSec": 9
      },
      {
        "id": "brute",
        "chapterId": "count",
        "intent": "Logging every request costs a row each; a counter costs one number",
        "targetSec": 13
      },
      {
        "id": "bucket",
        "chapterId": "bucket",
        "intent": "Requests spend tokens; an empty bucket answers 429 until the refill",
        "targetSec": 15
      },
      {
        "id": "store",
        "chapterId": "store",
        "intent": "The count lives in Redis: INCR per request, EXPIRE per window",
        "targetSec": 11
      },
      {
        "id": "fleet",
        "chapterId": "fleet",
        "intent": "Per-server counters let a user through once per server",
        "targetSec": 12
      },
      {
        "id": "fleet-fix",
        "chapterId": "fleet",
        "intent": "Every server asks one shared Redis, so the limit holds",
        "targetSec": 8
      },
      {
        "id": "payoff",
        "chapterId": "payoff",
        "intent": "The flood stops at the limiter instead of the API",
        "targetSec": 12
      }
    ],
    "plantedQuestion": {
      "text": "Why did the API fall over?",
      "beatId": "hook",
      "payoffBeatId": "payoff"
    },
    "ending": {
      "kind": "spec_card_ending",
      "specCard": {
        "lines": [
          "A token bucket per user",
          "Count in Redis: INCR, then EXPIRE",
          "Share one counter across all API servers"
        ]
      },
      "seriesNumber": 12,
      "cta": "Send this to whoever owns your API gateway, before the next flood finds it"
    }
  },
  "script": [
    {
      "beatId": "hook",
      "narration": "One buggy script sends ten thousand requests a second at your API. It slows, then falls over, and every real user gets an error.",
      "headline": {
        "text": "One client can take down everyone",
        "semantic": "problem",
        "at": { "type": "word_text", "text": "falls" }
      },
      "tags": ["503"]
    },
    {
      "beatId": "brute",
      "narration": "The brute force way logs every request and counts the rows each time. A hundred requests means a hundred rows per user. One counter per user does the same job with a single number.",
      "headline": { "text": "Counter = one number per user", "semantic": "concept" },
      "tags": ["100 rows", "1 number"]
    },
    {
      "beatId": "bucket",
      "narration": "A token bucket gives each user a hundred tokens. Every request spends one. At zero, the next request gets a 429. A timer refills the bucket every minute, so a short burst is fine, but a flood is not.",
      "headline": { "text": "Token bucket = bursts ok, floods not", "semantic": "concept" },
      "tags": ["429"]
    },
    {
      "beatId": "store",
      "narration": "Keep that count in Redis. Each request runs INCR on the user's key, and EXPIRE clears it after sixty seconds. One fast round trip, one number per user.",
      "headline": { "text": "INCR to count, EXPIRE to reset", "semantic": "decision" },
      "commandBubble": { "text": "INCR rate:user-7f3" },
      "tags": ["EXPIRE 60"]
    },
    {
      "beatId": "fleet",
      "narration": "Now run two copies of the API. If each server counts on its own, a user gets a hundred requests on each one. Two hundred get through, double the limit.",
      "headline": {
        "text": "Local counters = limit times servers",
        "semantic": "problem",
        "at": { "type": "word_text", "text": "double" }
      },
      "tags": ["200 allowed"]
    },
    {
      "beatId": "fleet-fix",
      "narration": "The fix is the shared counter from before. Both servers ask the same Redis, so the limit holds whichever server answers.",
      "headline": { "text": "One shared count for every server", "semantic": "resolution" },
      "tags": ["100 total"]
    },
    {
      "beatId": "payoff",
      "narration": "Remember the flood? Without a limiter it knocks the API over. Put the limiter in front, and only a steady trickle reaches your servers, while every other user stays online. One gate in front keeps the API standing.",
      "headline": { "text": "The flood stops at the limiter", "semantic": "resolution" }
    }
  ],

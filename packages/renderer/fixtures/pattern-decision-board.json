  "script": [
    {
      "beatId": "brute-force-then-index",
      "narration": "To find order 512, the app checks every row one by one. Checking all of them is slow. An index on the order id points straight at the row, and it is found in one lookup."
    },
    {
      "beatId": "versus-split",
      "narration": "Here are two setups side by side. The same burst of ten thousand writes hits both. The lone database chokes, while the queued setup absorbs it."
    },
    {
      "beatId": "inference-card",
      "narration": "The model reads the payment's features: a large amount, a new device, three in the morning. It weighs them, and the fraud risk flips from unknown to eighty-seven percent. Change to a known device and it predicts six."
    },
    {
      "beatId": "pick-by-rule",
      "narration": "Three servers sit inside the fifty millisecond ring. The nearest one looks obvious, but it is overloaded, so that pick is crossed out. The server with spare capacity wins the request."
    },
    {
      "beatId": "failover",
      "narration": "Writes go to the leader and copy to two followers. Then the leader dies and its links break. A follower takes the crown, and the writer and the other follower reconnect to it."
    },
    {
      "beatId": "split-brain",
      "narration": "Two regions share one leader. Then the link between them snaps, and the clock starts. The far replica, cut off, crowns itself. Each side takes a different write to row seven. When the link heals, two leaders hold conflicting data."
    }
  ],

  "script": [
    {
      "beatId": "map",
      "narration": "A delivery map splits the town into zones, and every new order lands on a pin inside one of them."
    },
    {
      "beatId": "two-column",
      "narration": "The writer keeps the record on the left, and the reader copies it to the right a moment later."
    },
    {
      "beatId": "grid",
      "narration": "Six lockers wait in a grid, and the first two are booked together for one parcel."
    },
    {
      "beatId": "stacked-list",
      "narration": "Three commands run in order. The second one is the slow step, and a closer look shows why."
    },
    {
      "beatId": "centered-focus",
      "narration": "The cache sits in the middle, close to the three services that ask it for answers all day."
    },
    {
      "beatId": "pipeline",
      "narration": "Uploads enter on the left and a resizer works through each one."
    },
    {
      "beatId": "pipeline-more",
      "narration": "Then the store keeps every result, and a done tag marks the link."
    },
    {
      "beatId": "cycle",
      "narration": "Plan, build, check and learn, then the loop starts again with a counter of rounds."
    },
    {
      "beatId": "swimlane",
      "narration": "The phone asks the gateway, the gateway asks the ledger, and the answer travels back."
    },
    {
      "beatId": "versus-split",
      "narration": "One queue on the left, two queues on the right. The same rush hits both sides."
    },
    {
      "beatId": "near-far",
      "narration": "The edge copy is near, so a read takes a few milliseconds. The origin is far away.",
      "source": "Example lab notes, 2026"
    },
    {
      "beatId": "hub-spoke",
      "narration": "One broker in the hub hands work to four workers, and holds each lease for ten seconds."
    }
  ],

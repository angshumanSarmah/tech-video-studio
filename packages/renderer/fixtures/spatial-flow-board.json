  "script": [
    {
      "beatId": "map-base",
      "narration": "A map base sets the city scene with blocks, avenues and a river. It dims behind the story, then returns, and finally leaves."
    },
    {
      "beatId": "route-path",
      "narration": "A route path pins the depot and the locker. The van hops to the bridge, hops on to the locker, then the route smooths into one curve. The whole route glows and pulses. The bridge lights up, blinks, then closes. Finally it dims."
    },
    {
      "beatId": "zone-polygon",
      "narration": "Zone polygons mark service areas that overlap. North appears, central glows, south pulses and then overloads. North fades, central leaves, and the map glows, pulses, then dims."
    },
    {
      "beatId": "grid-overlay",
      "narration": "A grid overlay drops over the city. The hot cell lights up and pulses. A busy cell turns red, then fades. The grid glows and dims."
    },
    {
      "beatId": "slot-grid",
      "narration": "A slot grid shows lockers. You pick one and it glows. Your app locks it. A second app grabs it too and is refused, then cleared and released. Another is emptied, one blinks, one dims, then the emptied locker is back. The bank glows, then dims."
    },
    {
      "beatId": "connector",
      "narration": "A connector draws from the client to the API. A request travels, glows, then pulses. The link breaks, comes back, and finally dims."
    },
    {
      "beatId": "packet-stream",
      "narration": "A packet stream starts flowing along the link, steady traffic. It glows, then pulses. The database refuses the flood. The stream dims, and then stops."
    },
    {
      "beatId": "conveyor-queue",
      "narration": "A conveyor queue carries print jobs. A new job joins at the back. The front job is claimed, then taken. The next is flagged, one blinks, one is bad. The belt glows, pulses, and dims."
    },
    {
      "beatId": "segmented-time-bar",
      "narration": "A segmented time bar fills with each step of a release. Testing glows, building blinks, the deploy blows the budget, and building fades. The total glows, pulses, then dims."
    }
  ],

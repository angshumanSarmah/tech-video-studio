  "script": [
    {
      "beatId": "map-base",
      "narration": "A map base sets the city scene with blocks, avenues and a river. It dims behind the story, then returns, and finally leaves."
    },
    {
      "beatId": "route-path",
      "narration": "A route path pins the store and the home, then draws the ride. The whole route glows and pulses. The crossing lights up, blinks, then closes. Finally it dims."
    },
    {
      "beatId": "zone-polygon",
      "narration": "Zone polygons mark delivery areas that overlap. North appears, central glows, south pulses and then overloads. North fades, central leaves, and the map glows, pulses, then dims."
    },
    {
      "beatId": "grid-overlay",
      "narration": "A grid overlay drops over the city. Your cell lights up and pulses. A busy cell turns red, then fades. The grid glows and dims."
    },
    {
      "beatId": "slot-grid",
      "narration": "A slot grid shows seats. You pick one and it glows. Your app locks it. A rival grabs it too and is refused. Another is sold, one blinks, one dims, then the sold seat is back. The hall glows, then dims."
    },
    {
      "beatId": "connector",
      "narration": "A connector draws from the client to the API. A request travels, glows, then pulses. The link breaks, and finally dims."
    },
    {
      "beatId": "packet-stream",
      "narration": "A packet stream starts flowing along the link, steady traffic. It glows, then pulses. The database refuses the flood. The stream dims, and then stops."
    },
    {
      "beatId": "conveyor-queue",
      "narration": "A conveyor queue carries orders. A new order joins at the back. The front order is claimed, then taken. The next is flagged, one blinks, one is bad. The belt glows, pulses, and dims."
    },
    {
      "beatId": "segmented-time-bar",
      "narration": "A segmented time bar fills with each step of the order. Packing glows, picking blinks, the ride blows the budget, and picking fades. The total glows, pulses, then dims."
    }
  ],

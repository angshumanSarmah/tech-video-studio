  "script": [
    {
      "beatId": "tag",
      "narration": "A tag names a state in two words. It can glow, pulse for attention, get rejected in red, and then fade into the background."
    },
    {
      "beatId": "node-card",
      "narration": "A node card is one component of the system. Its crown marks the leader; the crown steps away and returns. It lights up when it matters, pulses under load, locks while it holds a resource, crashes with a reject, and then dims."
    },
    {
      "beatId": "icon",
      "narration": "An icon is a bare symbol, like this database. It glows when the story points at it, pulses once, then dims, and finally leaves."
    },
    {
      "beatId": "item-icon",
      "narration": "An item icon is an everyday object, like a movie ticket. It glows when it matters, pulses, gets rejected when someone else took the seat, and finally dims."
    },
    {
      "beatId": "counter",
      "narration": "A counter is one big number. It counts up as the traffic grows, glows at the peak, pulses for effect, and then dims."
    },
    {
      "beatId": "counter-transition",
      "narration": "A counter transition shows one change. Ten seats become nine the moment one is booked. It glows, pulses, and then dims."
    },
    {
      "beatId": "timer-ring",
      "narration": "A timer ring counts down a hold. The ten minute clock starts ticking now, glows as time runs short, pulses, expires when the payment never comes, and then dims."
    },
    {
      "beatId": "stat-card",
      "narration": "A stat card shows one cited figure with its source underneath. It glows when the narration lands on it, pulses, and then dims."
    },
    {
      "beatId": "data-block",
      "narration": "A data block types in a record field by field, like a ride request on its way to a driver. It glows when it is complete, pulses, and then dims."
    },
    {
      "beatId": "command-bubble",
      "narration": "A command bubble types out one command, like setting a key only if it does not exist yet. It glows, pulses, gets rejected when the key is taken, and dims."
    },
    {
      "beatId": "formula-card",
      "narration": "A formula card typesets the one equation a topic rests on, like the cache hit ratio. It glows, pulses, and then dims."
    }
  ],

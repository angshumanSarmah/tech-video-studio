  "script": [
    {
      "beatId": "inset-panel",
      "narration": "Zoom into the store and an inset panel opens over the scene. Inside, the order features type in, and the prediction flips from unknown to fourteen minutes. The panel lights up, pulses, dims, then shrinks back into the store."
    },
    {
      "beatId": "bracket",
      "narration": "Three replicas sit side by side, and a bracket draws under them: quorum. It lights up, pulses once, dims, and then lets go."
    },
    {
      "beatId": "callout",
      "narration": "A callout pops in beside the kitchen with a what if. It lights up, pulses, then the assumption is ruled out, it dims, and leaves.",
      "source": "Example Eats delivery study, March 2025"
    },
    {
      "beatId": "device-frame",
      "narration": "A device frame shows a rider's phone. A third order slides in. The first order lights up and blinks. The second is declined, and the third drops off. The whole phone glows, pulses, and the button turns to accepted. Then it dims."
    },
    {
      "beatId": "radius-ring",
      "narration": "A radius ring grows out around the restaurant: two kilometres. The ring lights up, pulses, dims, and fades away."
    },
    {
      "beatId": "statement-card",
      "narration": "A statement card rises over the scene. Easy: find nearby riders. Hard: pick the right one. The hard line glows and throbs. The card lights up, pulses, dims, and the easy line leaves before the card goes."
    }
  ],

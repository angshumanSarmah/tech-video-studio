  "script": [
    {
      "beatId": "inset-panel",
      "narration": "Zoom into the payments node and an inset panel opens over the scene. Inside, the transaction features type in, and the risk score flips from unknown to eighty-seven percent. The panel lights up, pulses, dims, then shrinks back into the node."
    },
    {
      "beatId": "bracket",
      "narration": "Three replicas sit side by side, and a bracket draws under them: quorum. It lights up, pulses once, dims, and then lets go."
    },
    {
      "beatId": "callout",
      "narration": "A callout pops in beside the scheduler with a what if. It lights up, pulses, then the assumption is ruled out, comes back, it dims, and leaves.",
      "source": "Example Labs scheduler study, March 2025"
    },
    {
      "beatId": "device-frame",
      "narration": "A device frame shows a support agent's phone. A third ticket slides in. The first ticket lights up and blinks. The second is declined, and the third drops off. The whole phone glows, pulses, and the button turns to claimed. Then it dims."
    },
    {
      "beatId": "radius-ring",
      "narration": "A radius ring grows out around the depot: two kilometres. The ring lights up, pulses, dims, and fades away."
    },
    {
      "beatId": "statement-card",
      "narration": "A statement card rises over the scene. Easy: copy the data. Hard: keep it in sync. The hard line glows and throbs. The card lights up, pulses, dims, and the easy line leaves before the card goes."
    }
  ],

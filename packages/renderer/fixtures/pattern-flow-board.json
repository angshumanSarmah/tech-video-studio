  "script": [
    {
      "beatId": "atomic-lock",
      "narration": "Two people tap room B2 at once. Mira arrives first and the room locks for ten minutes. Theo taps a moment later and bounces off. When the ten minutes run out, the room frees up again."
    },
    {
      "beatId": "reject-duplicate",
      "narration": "The app sends payment 7781 to the server. The network hiccups, so it retries with the same id. The server sees it again and stamps it duplicate."
    },
    {
      "beatId": "fan-out",
      "narration": "A creator posts once. The broker copies the post to three regions, and each region delivers it to a million followers."
    },
    {
      "beatId": "flood-then-funnel",
      "narration": "Ten thousand clients hammer the database at once. It buckles under the load. Put a queue in front, and one steady line of writes gets through."
    },
    {
      "beatId": "converge-adapter",
      "narration": "Card, UPI and wallet payments each speak their own format. The gateway translates every one, and out comes a single payment event."
    },
    {
      "beatId": "cache-hit-miss",
      "narration": "The app asks the cache first. A hit comes back in two milliseconds. A miss goes all the way to the database and takes a hundred and twenty."
    },
    {
      "beatId": "worker-pool",
      "narration": "Uploads wait in a queue. Three workers each grab the next video, and a few seconds later each one hands back a thumbnail."
    }
  ],

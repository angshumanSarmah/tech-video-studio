{
  "name": "@explainer-studio/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generic Remotion compositions (React) that render a VideoSpec, plus the theme system.",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./catalog": "./src/catalog/index.ts",
    "./fixtures": "./fixtures/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "studio": "remotion studio src/entry.ts",
    "still:theme": "tsx scripts/render-theme-compare.ts --only swatch",
    "still:safe-area": "remotion still src/entry.ts SafeAreaCalibration ../../docs/safe-area/zones.png",
    "still:primitives": "tsx scripts/render-primitive-stills.ts",
    "still:patterns": "tsx scripts/render-pattern-stills.ts",
    "still:pattern-layouts": "tsx scripts/render-pattern-layout-stills.ts",
    "still:layouts": "tsx scripts/render-layout-stills.ts",
    "still:compare": "tsx scripts/render-theme-compare.ts",
    "calibrate:safe-area": "tsx scripts/calibrate-safe-area.ts",
    "gen:catalogue": "tsx scripts/generate-catalogue.ts",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "fonts:subset": "tsx scripts/subset-fonts.ts"
  },
  "dependencies": {
    "@explainer-studio/shared": "workspace:*",
    "@remotion/fonts": "catalog:",
    "fast-xml-parser": "catalog:",
    "katex": "catalog:",
    "lucide": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remotion": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@remotion/bundler": "catalog:",
    "@remotion/cli": "catalog:",
    "@remotion/renderer": "catalog:",
    "@types/fontkit": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "fontkit": "catalog:",
    "subset-font": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
